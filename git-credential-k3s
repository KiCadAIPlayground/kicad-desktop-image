#!/usr/bin/python3
"""git credential helper: asks krt-mcp for a short-lived GitHub App token (only github.com gets one)."""
import os
import sys
import urllib.request

if sys.argv[1:] != ["get"]:  # store / erase: nothing to remember
    sys.exit(0)
url = os.environ.get("KRT_GIT_TOKEN_URL", "http://krt-mcp.kicad.svc.cluster.local:3335/git-token")
req = urllib.request.Request(url, data=sys.stdin.buffer.read(),
                             headers={"Authorization": "Bearer " + os.environ.get("KRT_MCP_TOKEN", "")})
try:
    sys.stdout.write(urllib.request.urlopen(req, timeout=20).read().decode())
except Exception as e:  # no answer: git moves on to the next helper and then fails
    print(f"git-credential-k3s: {e}", file=sys.stderr)
