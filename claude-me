#!/bin/sh
# claude-me [name] [claude args...]: Claude Code with its own login per person on the shared desktop.
base=/config/claude
usage() {
  echo "usage: claude-me <name> [claude args...]   (name: [a-z0-9-]{1,32}; profile in $base/<name>)"
  echo "existing profiles:"
  ls "$base" 2>/dev/null | grep -v "^\.active$" | sed 's/^/  /'
}
case "$1" in -h | --help) usage; exit 0 ;; esac
if [ -z "$1" ]; then
  if [ -t 0 ]; then
    usage
    printf 'Your name (profile): '
    read -r name || exit 2
  else
    usage >&2
    exit 2
  fi
else
  name=$1
  shift
fi
if ! printf '%s' "$name" | grep -qE '^[a-z0-9-]{1,32}$'; then
  echo "claude-me: invalid name '$name'" >&2
  exit 2
fi
mkdir -p "$base/$name" && chmod 700 "$base/$name" || exit 1
export CLAUDE_CONFIG_DIR="$base/$name"
# you become the active driver: the shared KiCad's AI buttons (KiCadRoutingTools) now run on your login
printf '%s\n' "$name" > "$base/.active" && chmod 600 "$base/.active"
echo "claude-me: AI buttons in the shared KiCad now use $name's login (whoever runs claude-me last takes over)" >&2
cd /config/projects 2>/dev/null || true
# kicad-happy is a plugin (skills + manifest); KiCadRoutingTools keeps its skills in .claude/skills, which
# --add-dir loads (it has no plugin manifest, so --plugin-dir does not apply to it)
exec claude --plugin-dir /opt/kicad-happy --add-dir /opt/kicad-plugins/KiCadRoutingTools "$@"
